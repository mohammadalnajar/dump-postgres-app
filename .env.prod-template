# Production Environment Configuration Template
# Copy this to .env and customize for your production environment

# =================================
# APPLICATION SETTINGS
# =================================
APP_PORT=8080
APP_BASE_PATH=/
APP_TITLE=Postgres Dump App
NODE_ENV=production

# =================================
# SECURITY SETTINGS (CRITICAL)
# =================================
# Session-based authentication (REQUIRED)
USE_SESSION_AUTH=true
AUTH_USERNAME=your_admin_username_here
AUTH_PASSWORD=your_very_secure_password_here

# Session security (GENERATE NEW - use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
SESSION_SECRET=REPLACE_WITH_64_CHARACTER_RANDOM_STRING

# Cron job encryption (GENERATE NEW - use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CRON_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_STRING

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Trust proxy (REQUIRED for HTTPS behind nginx)
TRUST_PROXY=true

# =================================
# DATABASE DUMP DEFAULTS
# =================================
DEFAULT_FORMAT=custom
DEFAULT_OUTPUT_STYLE=standard
DEFAULT_INSERT_FORMAT=copy
DEFAULT_INCLUDE_OWNER=false
DEFAULT_COMPRESS_LEVEL=6
DEFAULT_EXCLUDE_SCHEMA=
DEFAULT_ONLY_SCHEMA=
DEFAULT_ONLY_DATA=false
DEFAULT_EXTRA_ARGS=--no-privileges --no-owner

# =================================
# BACKUP MANAGEMENT
# =================================
# Auto cleanup old backups (days)
AUTO_CLEAN_DAYS=7

# =================================
# LOGGING & MONITORING
# =================================
LOG_LEVEL=info
NO_PORT_LOGS=true