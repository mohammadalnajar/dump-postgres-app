# App
APP_PORT=8080
APP_BASE_PATH=/                # useful if reverse-proxying under a subpath
APP_TITLE=Simple Postgres Backup

# Security (optional)
BASIC_AUTH_USER=               # set to enable basic auth
BASIC_AUTH_PASS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Default pg_dump options (can be overridden in the form)
DEFAULT_FORMAT=plain           # plain | custom | directory | tar
DEFAULT_INCLUDE_OWNER=true
DEFAULT_COMPRESS_LEVEL=0       # 0..9 (only for custom/tar)
DEFAULT_EXCLUDE_SCHEMA=
DEFAULT_ONLY_SCHEMA=
DEFAULT_ONLY_DATA=false
DEFAULT_EXTRA_ARGS=            # e.g. --no-privileges

# File retention (optional)
AUTO_CLEAN_DAYS=               # e.g. 14 (disabled if empty)
