# App
APP_PORT=8080
APP_BASE_PATH=/                # useful if reverse-proxying under a subpath
APP_TITLE=Postgres Dump App

# Authentication Configuration
# Set USE_SESSION_AUTH=false to use legacy basic auth
USE_SESSION_AUTH=true

# Session-based authentication (recommended)
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123         # Change this in production!
SESSION_SECRET=your-very-secure-secret-key-change-in-production

# Cron job encryption key (REQUIRED for encrypted password storage)
CRON_ENCRYPTION_KEY="your-64-character-hex-string-here"
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Legacy Basic Auth (only used if USE_SESSION_AUTH=false)
BASIC_AUTH_USER=               # set to enable basic auth
BASIC_AUTH_PASS=

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Default pg_dump options (can be overridden in the form)
DEFAULT_FORMAT=plain           # plain | custom | directory | tar
DEFAULT_OUTPUT_STYLE=standard  # standard | navicat
DEFAULT_INSERT_FORMAT=copy     # copy | inserts (for navicat style)
DEFAULT_INCLUDE_OWNER=true
DEFAULT_COMPRESS_LEVEL=0       # 0..9 (only for custom/tar)
DEFAULT_EXCLUDE_SCHEMA=
DEFAULT_ONLY_SCHEMA=
DEFAULT_ONLY_DATA=false
DEFAULT_EXTRA_ARGS=            # e.g. --no-privileges

# File retention (optional)
AUTO_CLEAN_DAYS=               # e.g. 14 (disabled if empty)
