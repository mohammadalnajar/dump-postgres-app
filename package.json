{
    "name": "dump-postgres-app",
    "version": "1.0.0",
    "description": "Tiny Express UI to create Postgres backups using pg_dump",
    "main": "src/server.js",
    "type": "module",
    "scripts": {
        "start": "node src/server.js",
        "dev": "NODE_ENV=development node src/server.js",
        "todos": "bash scripts/scan-todos.sh",
        "todos:watch": "watch -n 30 'bash scripts/scan-todos.sh'",
        "plan": "echo '📋 Opening TODO.md and JOURNAL.md for planning...' && code TODO.md JOURNAL.md"
    },
    "dependencies": {
        "basic-auth": "^2.0.1",
        "bcryptjs": "^3.0.2",
        "compression": "^1.7.4",
        "dotenv": "^17.2.2",
        "ejs": "^3.1.10",
        "express": "^4.19.2",
        "express-rate-limit": "^7.4.0",
        "express-session": "^1.18.2",
        "helmet": "^7.1.0",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "node-cron": "^4.2.1",
        "uuid": "^13.0.0"
    }
}
