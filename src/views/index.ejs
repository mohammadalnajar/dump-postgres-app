<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css" />
</head>

<body>
    <main class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
            <h1><%= title %></h1>
            <form method="POST" action="/logout" style="margin: 0;">
                <button type="submit" style="background: #dc3545; color: white; border: none; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer;">
                    Logout
                </button>
            </form>
        </div>

        <form method="POST" action="/backup">
            <!-- Cron Job Configuration -->
            <fieldset id="cronJobSection" style="display: none;">
                <legend>Schedule Backup Job</legend>
                <div class="grid">
                    <label>Job Name <input name="jobName" placeholder="My backup job" /></label>
                    <label>Schedule
                        <select name="cronPreset" id="cronPreset">
                            <% predefinedPatterns.forEach(pattern => { %>
                            <option value="<%= pattern.value %>"><%= pattern.label %></option>
                            <% }) %>
                        </select>
                    </label>
                </div>
                <div id="customCronPattern" style="display: none;">
                    <label>Custom Cron Pattern
                        <input name="cronPattern" placeholder="0 0 * * *" />
                        <small>Format: minute hour day month weekday</small>
                    </label>
                    <div id="cronDescription" style="margin-top: 0.5rem; color: #666; font-size: 0.9rem;"></div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Connection</legend>
                <div class="grid">
                    <label>Host <input name="host" required placeholder="db.example.com" /></label>
                    <label>Port <input name="port" type="number" min="1" max="65535" value="5432" /></label>
                    <label>Database <input name="db" required placeholder="mydb" /></label>
                    <label>User <input name="user" required placeholder="dbuser" /></label>
                    <label>Password <input name="password" type="password" required placeholder="••••••••" /></label>
                </div>
            </fieldset>

            <fieldset>
                <legend>Options</legend>
                <div class="grid">
                    <label>Format
                        <select name="format">
                            <option value="plain" <%= defaults.format==='plain'?'selected':'' %>>Plain (.sql)</option>
                            <option value="custom" <%= defaults.format==='custom'?'selected':'' %>>Custom (.dump)
                            </option>
                            <option value="tar" <%= defaults.format==='tar'?'selected':'' %>>Tar (.tar)</option>
                        </select>
                    </label>

                    <label>Output Style
                        <select name="outputStyle" id="outputStyle">
                            <option value="standard" <%= defaults.outputStyle==='standard'?'selected':'' %>>Standard pg_dump</option>
                            <option value="navicat" <%= defaults.outputStyle==='navicat'?'selected':'' %>>Navicat-like</option>
                        </select>
                    </label>

                    <label>Data Format (for Navicat style)
                        <select name="insertFormat" id="insertFormat">
                            <option value="copy" <%= defaults.insertFormat==='copy'?'selected':'' %>>COPY statements</option>
                            <option value="inserts" <%= defaults.insertFormat==='inserts'?'selected':'' %>>INSERT statements</option>
                        </select>
                    </label>

                    <label>Include owner?
                        <select name="includeOwner">
                            <option value="">Default</option>
                            <option value="true" <%= defaults.includeOwner===true?'selected':'' %>>Yes</option>
                            <option value="false" <%= defaults.includeOwner===false?'selected':'' %>>No</option>
                        </select>
                    </label>

                    <label>Only schema (name)
                        <input name="onlySchema" placeholder="public or schema_name"
                            value="<%= defaults.onlySchema||'' %>" />
                    </label>

                    <label>Data only?
                        <select name="onlyData">
                            <option value="">No</option>
                            <option value="true" <%= defaults.onlyData===true?'selected':'' %>>Yes</option>
                        </select>
                    </label>

                    <label>Exclude schema
                        <input name="excludeSchema" placeholder="information_schema"
                            value="<%= defaults.excludeSchema||'' %>" />
                    </label>

                    <label>Compression level (0-9)
                        <input name="compressLevel" type="number" min="0" max="9"
                            value="<%= defaults.compressLevel ?? 0 %>" />
                    </label>

                    <label>Extra args
                        <input name="extraArgs" placeholder="--no-privileges --column-inserts"
                            value="<%= defaults.extraArgs||'' %>" />
                    </label>
                </div>
            </fieldset>

            <fieldset>
                <legend>Actions</legend>
                <div style="display: flex; gap: 1rem; align-items: center;">
                    <label style="display: flex; align-items: center; gap: 0.5rem;">
                        <input type="checkbox" id="enableCronJob" />
                        Schedule as cron job
                    </label>
                </div>
                <div style="margin-top: 1rem;">
                    <button type="submit" id="submitBtn">Create Backup</button>
                </div>
            </fieldset>
        </form>

        <% if (message) { %>
        <div class="message"><%= message %></div>
        <% } %>

        <section>
            <h2>Backups</h2>
            <table>
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Size</th>
                        <th>Modified</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% files.forEach(f => { %>
                    <tr>
                        <td><%= f.name %></td>
                        <td><%= (f.size/1024/1024).toFixed(2) %> MB</td>
                        <td><%= f.mtime.toLocaleString() %></td>
                        <td class="actions">
                            <a href="/download/<%= encodeURIComponent(f.name) %>">Download</a>
                            <form method="POST" action="/delete/<%= encodeURIComponent(f.name) %>"
                                style="display:inline" onsubmit="return confirm('Delete this file?')">
                                <button type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </section>

        <section>
            <h2>Scheduled Backup Jobs</h2>
            <% if (cronJobs && cronJobs.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Schedule</th>
                        <th>Database</th>
                        <th>Status</th>
                        <th>Last Run</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% cronJobs.forEach(job => { %>
                    <tr>
                        <td><%= job.name %></td>
                        <td>
                            <code><%= job.cronPattern %></code>
                            <br><small style="color: #666;"><%= job.cronPattern === '0 * * * *' ? 'Every hour' : 
                                job.cronPattern === '0 0 * * *' ? 'Daily at midnight' :
                                job.cronPattern === '*/5 * * * *' ? 'Every 5 minutes' :
                                job.cronPattern === '*/10 * * * *' ? 'Every 10 minutes' :
                                job.cronPattern === '*/30 * * * *' ? 'Every 30 minutes' :
                                job.cronPattern === '0 */6 * * *' ? 'Every 6 hours' :
                                job.cronPattern === '0 0 * * 0' ? 'Weekly on Sunday' :
                                job.cronPattern === '0 0 1 * *' ? 'Monthly' :
                                'Custom pattern' %></small>
                        </td>
                        <td><%= job.config.db %>@<%= job.config.host %></td>
                        <td>
                            <span class="status-badge status-<%= job.enabled ? 'enabled' : 'disabled' %>">
                                <%= job.enabled ? 'Enabled' : 'Disabled' %>
                            </span>
                        </td>
                        <td>
                            <% if (job.lastRun) { %>
                                <%= new Date(job.lastRun).toLocaleString() %>
                                <br><small class="status-<%= job.lastStatus %>">
                                    <%= job.lastStatus === 'success' ? '✓' : '✗' %> <%= job.lastStatus %>
                                </small>
                            <% } else { %>
                                <em>Never</em>
                            <% } %>
                        </td>
                        <td class="actions">
                            <form method="POST" action="/cron-jobs/<%= job.id %>/toggle" style="display:inline">
                                <button type="submit" class="btn-small">
                                    <%= job.enabled ? 'Disable' : 'Enable' %>
                                </button>
                            </form>
                            <form method="POST" action="/cron-jobs/<%= job.id %>/delete" 
                                  style="display:inline" 
                                  onsubmit="return confirm('Delete this cron job?')">
                                <button type="submit" class="btn-small btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
            <% } else { %>
            <p>No scheduled backup jobs configured. Create a backup with "Schedule as cron job" enabled to add one.</p>
            <% } %>
        </section>
    </main>

    <script>
        // Show/hide options based on output style
        function toggleFormatOptions() {
            const outputStyle = document.getElementById('outputStyle').value;
            const insertFormatLabel = document.querySelector('label:has(#insertFormat)');
            const formatSelect = document.querySelector('select[name="format"]');
            const compressLabel = document.querySelector('label:has(input[name="compressLevel"])');
            
            if (outputStyle === 'navicat') {
                insertFormatLabel.style.display = 'block';
                // Disable format selection for Navicat style (always uses plain)
                formatSelect.disabled = true;
                formatSelect.value = 'plain';
                compressLabel.style.display = 'none';
            } else {
                insertFormatLabel.style.display = 'none';
                formatSelect.disabled = false;
                compressLabel.style.display = 'block';
            }
        }

        // Handle cron job checkbox
        function toggleCronJobSection() {
            console.log('toggleCronJobSection called');
            const checkbox = document.getElementById('enableCronJob');
            const cronSection = document.getElementById('cronJobSection');
            const submitBtn = document.getElementById('submitBtn');
            const form = document.querySelector('form');
            const jobNameInput = document.querySelector('input[name="jobName"]');
            
            console.log('Checkbox element:', checkbox);
            console.log('Checkbox checked:', checkbox ? checkbox.checked : 'null');
            console.log('Cron section:', cronSection);
            
            if (!checkbox || !cronSection || !submitBtn || !form) {
                console.error('Missing required elements for cron job toggle');
                return;
            }
            
            if (checkbox.checked) {
                console.log('Showing cron job section');
                cronSection.style.display = 'block';
                submitBtn.textContent = 'Create Scheduled Backup Job';
                form.action = '/cron-jobs';
                // Make cron job fields required
                if (jobNameInput) {
                    jobNameInput.required = true;
                }
            } else {
                console.log('Hiding cron job section');
                cronSection.style.display = 'none';
                submitBtn.textContent = 'Create Backup';
                form.action = '/backup';
                // Remove required from cron job fields
                if (jobNameInput) {
                    jobNameInput.required = false;
                }
            }
        }

        // Handle cron preset selection
        function toggleCustomCronPattern() {
            const preset = document.getElementById('cronPreset').value;
            const customSection = document.getElementById('customCronPattern');
            
            if (preset === 'custom') {
                customSection.style.display = 'block';
                document.querySelector('input[name="cronPattern"]').required = true;
            } else {
                customSection.style.display = 'none';
                document.querySelector('input[name="cronPattern"]').required = false;
            }
        }

        // Validate and describe custom cron pattern
        async function validateCronPattern() {
            const patternInput = document.querySelector('input[name="cronPattern"]');
            const descriptionDiv = document.getElementById('cronDescription');
            const pattern = patternInput.value.trim();
            
            if (!pattern) {
                descriptionDiv.textContent = '';
                return;
            }
            
            try {
                const response = await fetch('/api/validate-cron', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ pattern })
                });
                
                const result = await response.json();
                
                if (result.valid) {
                    descriptionDiv.innerHTML = `<span style="color: green;">✓ ${result.description}</span>`;
                    patternInput.style.borderColor = 'green';
                } else {
                    descriptionDiv.innerHTML = `<span style="color: red;">✗ ${result.description}</span>`;
                    patternInput.style.borderColor = 'red';
                }
            } catch (error) {
                descriptionDiv.innerHTML = `<span style="color: orange;">Unable to validate pattern</span>`;
            }
        }
        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM Content Loaded');
            
            // Check if elements exist
            const enableCronJob = document.getElementById('enableCronJob');
            const outputStyle = document.getElementById('outputStyle');
            const cronPreset = document.getElementById('cronPreset');
            const cronPatternInput = document.querySelector('input[name="cronPattern"]');
            
            console.log('enableCronJob element:', enableCronJob);
            console.log('outputStyle element:', outputStyle);
            console.log('cronPreset element:', cronPreset);
            
            // Add event listeners only if elements exist
            if (outputStyle) {
                outputStyle.addEventListener('change', toggleFormatOptions);
            }
            
            if (enableCronJob) {
                enableCronJob.addEventListener('change', function() {
                    console.log('Checkbox changed, checked:', this.checked);
                    toggleCronJobSection();
                });
            }
            
            if (cronPreset) {
                cronPreset.addEventListener('change', toggleCustomCronPattern);
            }
            
            // Debounced validation for custom cron pattern
            if (cronPatternInput) {
                let cronValidationTimeout;
                cronPatternInput.addEventListener('input', function() {
                    clearTimeout(cronValidationTimeout);
                    cronValidationTimeout = setTimeout(validateCronPattern, 500);
                });
            }
            
            // Initialize states
            toggleFormatOptions();
            toggleCronJobSection();
            toggleCustomCronPattern();
        });
    </script>
</body>

</html>